# Executables and binaries
*.exe
*.zip
*.tif
*.tiff

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Obsidian local config/state (causes merge conflicts)
docs/journal/.obsidian/

# Raw XFOIL scratch output. build_polar_cache.py and xfoil_runner.py write
# their unparsed run output and per-run coordinate copies here; both are
# regenerable byproducts, and the distilled cache lives in data/polars/.
# The directory itself is kept (via .gitkeep) because those scripts write
# into it without creating it.
results/_archive/*
!results/_archive/.gitkeep

# Local one-time testing scratch space (not synced)
/testing/
